// HomIA — Ecosistema tripartito (Cliente / Profesional / Proveedor)
// Espejo funcional de supabase/migrations/0001-0011 (para replicar en otro sistema ver migrations)
// SQLite: sin enums (String), sin arrays (JSON string), sin PostGIS (Float lat/lng)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── IDENTIDAD ───────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  roles              String    @default("[]") // JSON: ["cliente","profesional","proveedor"]
  displayName        String
  phone              String?
  avatarUrl          String?
  howFoundUs         String? // google|redes|recomendacion|publicidad|otro
  birthday           String? // ISO date
  address            String?
  city               String?
  lat                Float?
  lng                Float?
  locationShared     Boolean   @default(false)
  searchRadiusKm     Float     @default(10)
  rating             Float     @default(0)
  reviewsCount       Int       @default(0)
  // Verificación de identidad por DNI + IA: none (no subió) | en_revision | verificado | rechazado
  // Se muestra PÚBLICamente junto al nombre (directorio, perfiles, mensajes).
  verificationStatus String    @default("none")
  verifiedAt         DateTime?
  // Avisos por mail de los eventos importantes (compras, contrataciones, facturas…).
  // Se apaga desde el perfil. El mail de recuperar contraseña se manda siempre.
  emailNotifications Boolean   @default(true)
  // Aceptación de Términos y Política de Privacidad al registrarse (D19, migración 0029).
  // termsVersion = LEGAL_VERSION de src/lib/legal-content.ts vigente al aceptar.
  termsAcceptedAt    DateTime?
  termsVersion       String?
  // Registro con datos estandarizados y verificación (D26, migración 0035).
  // emailVerifiedAt: cuándo probó con un código de 6 cifras que el email es suyo (las cuentas nuevas
  //   nacen verificadas; las anteriores quedan en NULL = "sin verificar" hasta que lo hagan en el perfil).
  // phoneE164: el celular normalizado (+549…); `phone` guarda cómo se muestra (+54 9 11 2345-6789).
  // phoneVerifiedAt: SIN USO desde el 25/09/2026 (el celular solo se estandariza con país, no se
  // verifica por código); queda en la base para no hacer una migración destructiva.
  emailVerifiedAt    DateTime?
  phoneE164          String?
  phoneVerifiedAt    DateTime?
  // "Eliminar mi cuenta" (Ley 25.326, D19): la cuenta queda anonimizada y oculta de todo lo
  // público; getSessionUser la trata como inexistente y el login la rechaza.
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  passwordResets    PasswordReset[]
  verificationCodes VerificationCode[]
  documents         IdentityDocument[]
  professional      ProfessionalProfile?
  provider          ProviderProfile?
  jobPosts          JobPost[]
  projectsAsClient  Project[]            @relation("ProjectClient")
  chargesAsClient   ProviderCharge[]     @relation("ChargeClient")
  worksAuthored     CompletedWork[]
  reviewsGiven      Review[]             @relation("ReviewAuthor")
  reviewsReceived   Review[]             @relation("ReviewTarget")
  pipelines         CrmPipeline[]
  notifications     Notification[]
  homySessions      HomySession[]
  favorites         Favorite[]
  dealsCounterparty CrmDeal[]            @relation("DealCounterparty")
  conversationsA    Conversation[]       @relation("ConversationA")
  conversationsB    Conversation[]       @relation("ConversationB")
  messagesSent      Message[]            @relation("MessageSender")
  purchases         Purchase[]           @relation("PurchaseClient")
  leftoverReturns   LeftoverReturn[]
  cartItems         CartItem[]
  orders            Order[]              @relation("OrderClient")
  feedbacks         Feedback[]
  financeEntries    FinanceEntry[]
  financeConfigs    FinanceConfig[]
}

model IdentityDocument {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("dni") // dni|pasaporte|cuit
  frontUrl  String?
  backUrl   String?
  status    String   @default("en_revision") // en_revision|verificado|rechazado
  // Dictamen del modelo de IA de visión que analiza frente+dorso
  aiVerdict String? // JSON: { esDocumento, pareceReal, legible, mismoTitular, motivo... }
  aiScore   Float? // confianza 0..1 de que sea un documento real
  aiNotes   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfessionalProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  personType          String    @default("persona") // persona|empresa
  professions         String    @default("[]") // JSON slugs: ["plomeria","gasistas"]
  skills              String    @default("[]") // JSON strings
  experienceYears     Int       @default(0)
  bio                 String?
  // Persona
  dniCuil             String?
  // Empresa
  companyName         String?
  companyCuit         String?
  companyWebsite      String?
  employeesCount      Int?
  // Operativa
  serviceRadiusKm     Float     @default(15)
  verified            Boolean   @default(false)
  rating              Float     @default(0)
  reviewsCount        Int       @default(0)
  worksCount          Int       @default(0)
  lat                 Float?
  lng                 Float?
  city                String?
  subscription        String    @default("free") // free|pro
  mpPreapprovalId     String? // id de preapproval de Mercado Pago (suscripción PRO)
  proSince            DateTime? // desde cuándo está activo el plan PRO
  // OAuth Mercado Pago — cobro directo al profesional
  mpOauthAccessToken  String?
  mpOauthRefreshToken String?
  mpOauthExpiresAt    DateTime?
  mpOauthStatus       String    @default("disconnected") // connected | disconnected
  // Jornada de trabajo (D23, migración 0032): "HH:MM"; null = 06:00–18:00. Decide si un día está
  // "completo" o "con lugar" en el calendario, la disponibilidad pública y Homy.
  workdayStart        String?
  workdayEnd          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bids            JobBid[]         @relation("BidProfessional")
  proProjects     Project[]        @relation("ProjectPro")
  providerLinks   ProviderLink[]
  // devoluciones de sobrantes donde el profesional es el vendedor (materiales cobrados en su factura)
  leftoverReturns LeftoverReturn[]
}

model ProviderProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  businessName        String
  kind                String    @default("multi") // corralon|ferreteria|electricidad|pintura|sanitarios|gas|maderera|carpinteria|aberturas|techos|jardineria|limpieza|climatizacion|herramientas|muebles|pisos|seguridad|multi
  cuit                String?
  description         String?
  address             String?
  city                String?
  lat                 Float?
  lng                 Float?
  verified            Boolean   @default(false)
  rating              Float     @default(0)
  reviewsCount        Int       @default(0)
  // Planes del proveedor (único rol con suscripción de pago):
  // trial (14 días gratis desde el alta) | basic (US$50/mes, usar la plataforma) | pro (US$100/mes, analítica + destacado + sponsor)
  subscription        String    @default("trial")
  trialEndsAt         DateTime? // fin de la prueba gratis de 14 días (null → se calcula desde createdAt)
  mpPreapprovalId     String? // id de preapproval de Mercado Pago (plan basic o pro)
  proSince            DateTime? // desde cuándo está activo el plan de pago
  // D33: suscripción cancelada (desde HomIA o desde Mercado Pago) con un período pago vigente →
  // el plan sigue operativo hasta esta fecha y el cron diario lo da de baja al vencer. null = sin baja programada.
  planPaidUntil       DateTime?
  // Marca del proveedor en la cinta de sponsors de la home (solo Plan PRO activo)
  brandLogoUrl        String? // logo en el bucket público homia-uploads (folder "marca")
  brandTagline        String? // frase de marca, máx. 60 caracteres
  brandColor          String? // color de marca en hex (#RRGGBB), opcional
  // OAuth Mercado Pago — cobro directo al proveedor
  mpOauthAccessToken  String?
  mpOauthRefreshToken String?
  mpOauthExpiresAt    DateTime?
  mpOauthStatus       String    @default("disconnected") // connected | disconnected
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock           ProviderStock[]
  links           ProviderLink[]
  stockMaterials  ProjectMaterial[]
  charges         ProviderCharge[]
  purchases       Purchase[]
  leftoverReturns LeftoverReturn[]
}

// ─────────────────────────── CATÁLOGO + STOCK ───────────────────────────

model Category {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  icon      String           @default("wrench")
  sortOrder Int              @default(0)
  elements  CatalogElement[]
}

model CatalogElement {
  id          String  @id @default(cuid())
  categoryId  String
  name        String // nombre estándar normalizado
  aliases     String  @default("[]") // JSON: nombres alternativos (cómo lo llama la gente)
  description String  @default("") // explicación natural: qué es, para qué sirve, dónde se usa
  unit        String  @default("unidad") // unidad|metro|m2|m3|kg|litro|bolsa|paquete|caja|rollo|placa|par|juego|pack|tira|tambor|barra|bobina|millar|lata
  active      Boolean @default(true)

  category      Category          @relation(fields: [categoryId], references: [id])
  stock         ProviderStock[]
  materials     ProjectMaterial[]
  leftoverItems LeftoverItem[]
}

model ProviderStock {
  id         String   @id @default(cuid())
  providerId String
  elementId  String
  price      Float
  quantity   Float    @default(0)
  minStock   Float    @default(5)
  status     String   @default("disponible") // disponible|por_agotar|agotado (derivado)
  brand      String?
  imageUrl   String?
  // Finanzas (D24, migración 0033): costo de compra por unidad, lo carga el proveedor.
  // null = sin dato (no se inventa: se usa el margen estimado declarado o se avisa).
  unitCost   Float?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  provider     ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  element      CatalogElement     @relation(fields: [elementId], references: [id])
  movements    StockMovement[]
  reservations StockReservation[]
  cartItems    CartItem[]

  @@unique([providerId, elementId])
}

model StockMovement {
  id        String        @id @default(cuid())
  stockId   String
  type      String // entrada|salida|ajuste|reserva|liberacion|consumo
  quantity  Float
  note      String?
  createdAt DateTime      @default(now())
  stock     ProviderStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
}

model StockReservation {
  id        String        @id @default(cuid())
  stockId   String
  projectId String?
  userId    String
  quantity  Float
  status    String        @default("activa") // activa|consumida|liberada
  createdAt DateTime      @default(now())
  stock     ProviderStock @relation(fields: [stockId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── BOLSA DE TRABAJOS ───────────────────────────

model JobPost {
  id            String   @id @default(cuid())
  userId        String
  title         String
  description   String
  categorySlug  String
  urgency       String   @default("normal") // baja|normal|alta|urgente
  budgetMin     Float?
  budgetMax     Float?
  address       String?
  city          String?
  lat           Float?
  lng           Float?
  photos        String   @default("[]") // JSON urls
  status        String   @default("abierto") // abierto|en_proceso|cerrado|cancelado
  selectedBidId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bids     JobBid[]
  projects Project[]
}

model JobBid {
  id             String   @id @default(cuid())
  jobId          String
  professionalId String // → ProfessionalProfile.id
  amount         Float
  timelineDays   Int      @default(7)
  message        String?
  status         String   @default("pendiente") // pendiente|aceptado|rechazado|retirado
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job          JobPost             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("BidProfessional", fields: [professionalId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── PROYECTOS + MATERIALES ───────────────────────────

model Project {
  id                   String    @id @default(cuid())
  jobId                String?
  clientId             String
  professionalId       String
  title                String
  description          String?
  status               String    @default("activo") // activo|finalizado|cancelado
  stage                String    @default("presupuesto") // presupuesto|materiales|ejecucion|revision|finalizado
  laborCost            Float     @default(0)
  budgetMin            Float? // presupuesto estimado del cliente (wizard), solo referencia
  budgetMax            Float?
  materialsCost        Float     @default(0)
  // Contratación guiada desde el directorio (wizard "Contratar")
  urgency              String? // ya|esta_semana|normal
  address              String?
  deadline             DateTime?
  photos               String? // JSON de URLs (fotos del trabajo a realizar)
  lat                  Float?
  lng                  Float?
  // Quién paga los materiales: "pro_adelanta" = el profesional adelanta los
  // materiales y los cobra junto con la mano de obra en la factura;
  // "cliente_paga_proveedor" = el cliente paga los materiales directamente al
  // proveedor (cobro aparte) y el profesional factura solo mano de obra.
  materialsPaymentMode String    @default("pro_adelanta")
  // Subcontratación (D16): proyecto del profesional del que sale esta contratación.
  // Solo lo ve el profesional que subcontrata; el cliente original no.
  parentProjectId      String?
  // Fechas del trabajo (D21, migración 0031): días guardados al mediodía UTC (ver src/lib/schedule.ts).
  //   scheduleStatus: null = sin fechas | propuesta | acordada
  //   scheduleProposedBy: profesional|cliente → quién hizo la propuesta vigente
  //     (con scheduleStatus null tras un rechazo: quién la rechazó; scheduleNote = motivo)
  //   prevStartDate/prevEndDate: fechas acordadas que siguen vigentes mientras se revisa una reprogramación
  startDate            DateTime?
  endDate              DateTime? // fin estimado
  scheduleStatus       String?
  scheduleProposedBy   String?
  scheduleNote         String?
  scheduleUpdatedAt    DateTime?
  prevStartDate        DateTime?
  prevEndDate          DateTime?
  // Franja horaria diaria (D23, migración 0032): "HH:MM" hora argentina, de a 15 min, fin > inicio.
  //   Cada día del rango el trabajo ocupa dailyStart–dailyEnd; null = día completo.
  //   prevDailyStart/prevDailyEnd: franja acordada vigente durante una reprogramación.
  dailyStart           String?
  dailyEnd             String?
  prevDailyStart       String?
  prevDailyEnd         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  job          JobPost?            @relation(fields: [jobId], references: [id])
  client       User                @relation("ProjectClient", fields: [clientId], references: [id])
  pro          ProfessionalProfile @relation("ProjectPro", fields: [professionalId], references: [id])
  parent       Project?            @relation("ProjectSubcontracts", fields: [parentProjectId], references: [id], onDelete: SetNull)
  subcontracts Project[]           @relation("ProjectSubcontracts")
  materials    ProjectMaterial[]
  invoices     Invoice[]
  charges      ProviderCharge[]
  works        CompletedWork[]

  @@index([parentProjectId])
  @@index([professionalId, startDate])
}

model ProjectMaterial {
  id              String   @id @default(cuid())
  projectId       String
  elementId       String?
  name            String // snapshot del nombre
  providerId      String?
  quantity        Float
  unit            String   @default("unidad")
  unitPrice       Float
  status          String   @default("propuesto") // propuesto|aprobado|rechazado|reemplazado
  alternativeOfId String?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  element       CatalogElement?   @relation(fields: [elementId], references: [id])
  provider      ProviderProfile?  @relation(fields: [providerId], references: [id])
  alternatives  ProjectMaterial[] @relation("MaterialAlternative")
  alternativeOf ProjectMaterial?  @relation("MaterialAlternative", fields: [alternativeOfId], references: [id])
  invoicedAt    DateTime? // ya incluido en una factura (no se refactura)
}

model Invoice {
  id             String    @id @default(cuid())
  projectId      String
  number         String    @unique
  clientId       String
  professionalId String
  laborCost      Float     @default(0)
  materialsCost  Float     @default(0)
  total          Float     @default(0)
  status         String    @default("pendiente") // pendiente|pagada|vencida
  paymentMethod  String? // mercadopago|efectivo (método elegido para liquidar)
  mpPreferenceId String?
  mpPaymentId    String?
  // Cargo de servicio HomIA (1%): lo paga el cliente SOLO si paga por Mercado
  // Pago; se fija al crear la preferencia de MP (efectivo → 0). No suma a `total`.
  serviceFee     Float     @default(0)
  paidAt         DateTime?
  issuedAt       DateTime  @default(now())

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  kind        String // material|mano_obra
  description String
  quantity    Float
  unitPrice   Float
  subtotal    Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id             String    @id @default(cuid())
  invoiceId      String? // factura de proyecto (null si es cobro directo o compra)
  chargeId       String? // ProviderCharge (cobro de materiales / venta directa)
  purchaseId     String? // Purchase (compra directa)
  method         String    @default("mercadopago") // mercadopago|efectivo
  mpPaymentId    String?   @unique
  // quién cobró el pago de MP: "vendedor" (token OAuth del vendedor) | "plataforma" (token de HomIA, histórico).
  // null = fila anterior al carrito: compras → vendedor; facturas y cobros → plataforma.
  collector      String?
  refundedAmount Float     @default(0) // suma de reembolsos MP (sobrantes)
  // Ingresos de HomIA (D30, migración 0037), tal como los informa MP en el pago (null = sin dato):
  // mpApplicationFee = `fee_details` tipo application_fee (lo que MP le acreditó a HomIA del cargo 1%);
  // mpApprovedAt = `date_approved`.
  mpApplicationFee Float?
  mpApprovedAt     DateTime?
  status         String // approved|acordado|confirmado|rejected, etc.
  amount         Float
  confirmedAt    DateTime? // efectivo: cuándo el profesional confirmó que cobró
  createdAt      DateTime  @default(now())
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@index([purchaseId])
}

// Cobro de materiales del proveedor al cliente (modo "cliente_paga_proveedor"):
// el proveedor emite el cobro por los materiales aprobados de un proyecto y el
// cliente lo paga con Mercado Pago o acuerda efectivo (el proveedor confirma).
model ProviderCharge {
  id             String    @id @default(cuid())
  projectId      String? // null → cobro de venta directa (compra sin proyecto)
  providerId     String
  clientId       String
  number         String    @unique
  description    String
  materialIds    String    @default("[]") // JSON: ids de ProjectMaterial incluidos (evita doble cobro)
  amount         Float
  status         String    @default("pendiente") // pendiente|acordada_efectivo|pagada
  method         String? // mercadopago|efectivo
  mpPreferenceId String?
  mpPaymentId    String?
  serviceFee     Float     @default(0) // cargo de servicio HomIA (1%) si se paga por MP; no suma a `amount`
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  client   User            @relation("ChargeClient", fields: [clientId], references: [id], onDelete: Cascade)
}

// Cuenta de retiro de materiales: vincula proveedor ↔ profesional (o usuario)
model ProviderLink {
  id             String   @id @default(cuid())
  providerId     String
  professionalId String // → ProfessionalProfile.id (o userId si cliente)
  accountLabel   String // nombre de la cuenta de retiro
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  provider     ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── OBRAS + RESEÑAS 360° ───────────────────────────

model CompletedWork {
  id             String   @id @default(cuid())
  authorId       String // quien publica (cliente o profesional)
  authorRole     String   @default("cliente") // cliente|profesional
  professionalId String?
  projectId      String?
  jobId          String?
  title          String
  description    String
  photos         String   @default("[]")
  categorySlug   String?
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())

  author  User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])
}

model Review {
  id           String    @id @default(cuid())
  authorId     String
  targetUserId String
  context      String    @default("proyecto") // proyecto|obra|perfil|compra
  projectId    String?
  workId       String?
  purchaseId   String? // reseña de una compra directa de insumos
  rating       Int
  comment      String
  photos       String    @default("[]") // JSON: URLs de fotos que avalan la reseña
  reply        String?
  replyAt      DateTime?
  createdAt    DateTime  @default(now())

  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target User @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
}

// ── COMPRAS DIRECTAS DE INSUMOS (cliente compra a proveedor sin proyecto) ──
// El cliente pide un producto desde el marketplace (panel Materiales), el
// proveedor lo acepta/entrega y el pago corre por los mismos rieles que los
// cobros de materiales (Mercado Pago o efectivo). Habilita reseña context=compra.
// Desde el carrito (2026-09): un Purchase es el SUB-PEDIDO de un proveedor dentro
// de un pedido (Order) y sus productos viven en `items` (PurchaseItem). Los campos
// de ítem único (stockId, elementId, quantity, unitPrice) quedan solo para las filas
// históricas; `elementName` guarda un resumen legible ("Cemento × 2 bolsa y 1 más").
model Purchase {
  id                   String    @id @default(cuid())
  orderId              String? // pedido del carrito al que pertenece (null = compra histórica)
  clientId             String
  providerId           String
  stockId              String? // histórico (ítem único)
  elementId            String? // histórico (ítem único)
  elementName          String // resumen legible del sub-pedido
  quantity             Float? // histórico (ítem único)
  unit                 String    @default("unidad")
  unitPrice            Float? // histórico (ítem único)
  total                Float // suma de los ítems (sin el cargo de servicio)
  serviceFee           Float     @default(0) // cargo de servicio HomIA (1%) fijado al pagar por MP
  note                 String?
  type                 String    @default("compra") // "compra" | "reserva"
  status               String    @default("pendiente_aprobacion")
  paymentMethod        String? // "mercadopago" | "efectivo" | null
  mpPreferenceId       String?
  mpPaymentId          String?
  rejectionReason      String?
  pickupDeadline       String?
  reservationExpiresAt DateTime?
  approvedAt           DateTime?
  // reserva SIN stock aprobada (estado `esperando_stock`): fecha aproximada en que el
  // proveedor va a tener el producto. El stock se reserva recién al marcarla "disponible".
  availableFrom        DateTime?
  chargeId             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client   User            @relation("PurchaseClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@index([orderId])
}

// Ítem de un sub-pedido: snapshot del producto al momento de pedir.
model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  stockId     String? // oferta del proveedor (puede borrarse después: el snapshot queda)
  elementId   String
  elementName String
  unit        String   @default("unidad")
  quantity    Float
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([elementId])
}

// ── CARRITO Y PEDIDOS ──
// Carrito de un usuario logueado (el del visitante vive en localStorage y se
// fusiona al iniciar sesión). Una fila por oferta (stock) con su cantidad.
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  stockId   String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock ProviderStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([userId, stockId])
  @@index([userId])
}

// Pedido confirmado desde el carrito: se fracciona en un Purchase por proveedor.
model Order {
  id        String   @id @default(cuid())
  number    String   @unique // PED-AAAA-NNNNNN
  clientId  String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    User       @relation("OrderClient", fields: [clientId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([clientId])
}

// Línea de tiempo trazable (pedidos, sub-pedidos y proyectos): solo se agregan
// filas; registrar un evento nunca rompe el flujo principal.
model ActivityEvent {
  id         String   @id @default(cuid())
  orderId    String?
  purchaseId String?
  projectId  String?
  actorId    String? // User que hizo la acción (null = sistema)
  actorRole  String // cliente|profesional|proveedor|sistema
  type       String // pedido_creado|aprobado|rechazado|cancelado|pago_mp_iniciado|pago_efectivo_acordado|pagado|entregado|vencido…
  message    String
  data       String? // JSON opcional
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([purchaseId, createdAt])
  @@index([projectId, createdAt])
}

// ─────────────────────────── CRM ───────────────────────────

model CrmPipeline {
  id        String   @id @default(cuid())
  ownerId   String
  ownerRole String // profesional|proveedor
  name      String
  createdAt DateTime @default(now())

  owner  User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stages CrmStage[]
  deals  CrmDeal[]
}

model CrmStage {
  id         String @id @default(cuid())
  pipelineId String
  name       String
  sortOrder  Int    @default(0)
  color      String @default("#1D63B8")

  pipeline CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    CrmDeal[]
}

model CrmDeal {
  id             String   @id @default(cuid())
  pipelineId     String
  stageId        String
  title          String
  value          Float    @default(0)
  counterpartyId String? // User id del cliente/profesional
  jobId          String?
  projectId      String?
  note           String?
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pipeline     CrmPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        CrmStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  counterparty User?       @relation("DealCounterparty", fields: [counterpartyId], references: [id])
}

// ─────────────────────────── MENSAJES DIRECTOS ───────────────────────────

// Conversación 1:1 entre cualquier par de usuarios (cliente/profesional/proveedor).
// userAId < userBId lexicográficamente para que la unicidad funcione en ambas direcciones.
model Conversation {
  id            String   @id @default(cuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA    User      @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  // la bandeja busca por userAId (lo cubre el unique) O por userBId: sin este
  // índice, el lado B recorre la tabla entera
  @@index([userBId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────── NOTIFICACIONES + IA ───────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sugerencias de los usuarios (D25, migración 0034). Las manda cualquier rol desde su panel
// (/panel/<rol>/sugerencias) y las responde un administrador (ADMIN_EMAILS) desde
// /panel/admin/sugerencias. Reglas puras en src/lib/feedback.ts.
model Feedback {
  id            String    @id @default(cuid())
  userId        String
  role          String // cliente|profesional|proveedor (panel desde el que escribió)
  type          String // sugerencia|queja|mejora|oportunidad|problema|otro
  area          String // busqueda|directorio|…|otra (src/lib/feedback.ts AREAS)
  title         String
  description   String
  photos        String    @default("[]") // JSON: paths privados "feedback-evidencias/<userId>/sugerencias/<archivo>"
  context       String? // JSON (solo "problema"): pantalla, navegador, dispositivo, fecha, zona horaria
  contactOk     Boolean   @default(true)
  status        String    @default("recibida") // recibida|en_revision|planificada|resuelta|descartada
  adminResponse String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
}

// Códigos de verificación de email y celular (D26, migración 0035). 6 cifras, vencen a los 10 min,
// hasta 5 intentos, un solo uso. Se guarda el HMAC-SHA256 del código (clave AUTH_SECRET), nunca el
// código. proposito "registro": todavía no hay cuenta (userId NULL, destino = email o celular que
// se está registrando); "cuenta": verificar después desde el perfil (userId = el dueño).
model VerificationCode {
  id        String    @id @default(cuid())
  userId    String?
  channel   String // email | celular
  purpose   String // registro | cuenta
  target    String // email normalizado o celular E.164
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, channel, purpose, createdAt])
  @@index([ip, createdAt])
  @@index([userId])
}

// Recuperar contraseña (migración 0028). El token real (32 bytes aleatorios, base64url)
// viaja SOLO en el link del mail; acá se guarda su sha256. Vence en 1 hora y se usa una vez.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HomySession {
  id          String   @id @default(cuid())
  userId      String?
  title       String   @default("Nueva conversación")
  // Súper agente Homy: puerta de entrada (home_buscador|home_flotante|panel|buscar)
  puerta      String?
  // Visitante sin cuenta: hash (sha256) del token que guarda su navegador. Nunca en claro.
  visitorHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages HomyMessage[]

  @@index([visitorHash])
}

model HomyMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user|homy|tool
  content   String
  intent    String? // JSON con categoría/urgencia/summary
  // Súper agente: corrida que generó la respuesta y lo que se mostró (tarjetas, acciones) en JSON
  runId     String?
  payload   String?
  createdAt DateTime @default(now())

  session HomySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Cupo diario de consultas al súper agente Homy.
// key = "ip:<hash>" (visitante, compartido home+flotante) | "user:<userId>" (logueado).
// day = fecha de Argentina (YYYY-MM-DD). Se incrementa atómicamente justo antes de llamar al modelo.
model AiUsage {
  id        String   @id @default(cuid())
  key       String
  day       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, day])
}

// Registro de cada corrida del súper agente Homy (observabilidad, costos, auditoría).
model HomyRun {
  id              String   @id @default(cuid())
  sessionId       String?
  userId          String?
  ipHash          String? // visitante: sha256(ip + AUTH_SECRET), nunca la IP en claro
  puerta          String // home_buscador|home_flotante|panel|buscar
  rol             String // visitante|cliente|profesional|proveedor
  pregunta        String
  pasos           String   @default("[]") // JSON [{herramienta, input, resumen, ms, estado}]
  modelo          String
  esfuerzo        String?
  vueltas         Int      @default(0)
  tokensEntrada   Int      @default(0)
  tokensSalida    Int      @default(0)
  tokensRazon     Int      @default(0)
  tokensCache     Int      @default(0)
  costoUsd        Float    @default(0) // estimado con el precio de lista del modelo
  latenciaMs      Int      @default(0)
  resultado       String // ok|limite|fallback_ia|agoto_vueltas|error
  error           String?
  respuesta       String? // mensaje final mostrado
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([resultado, createdAt])
}

model SearchEvent {
  id        String   @id @default(cuid())
  userId    String?
  mode      String   @default("cliente") // cliente|profesional
  query     String
  intent    String? // JSON
  results   String? // JSON resumen
  createdAt DateTime @default(now())
}

model Favorite {
  id           String   @id @default(cuid())
  userId       String
  targetUserId String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetUserId])
}

model OAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  sellerId     String // profileId del proveedor o profesional
  sellerKind   String // "provider" | "professional"
  codeVerifier String? // PKCE (la app de MP tiene PKCE activado)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ── Sobrantes: devolución de materiales al proveedor con reembolso ──
model LeftoverReturn {
  id                String               @id @default(cuid())
  requesterId       String // User que pide (cliente o profesional del proyecto)
  // Pata de la devolución (D14, 24/09/2026):
  //   cliente                 = el comprador (cliente, o profesional en modo B/compra) devuelve a quien le vendió;
  //   profesional_a_proveedor = el profesional devuelve al proveedor lo que le compró por fuera de HomIA (modo pro_adelanta).
  tipo              String               @default("cliente")
  // Quién vendió y por eso acepta, recibe y reembolsa: proveedor | profesional (materiales cobrados en la factura del profesional)
  sellerKind        String               @default("proveedor")
  providerId        String? // ProviderProfile que vendió (null cuando el vendedor es el profesional)
  professionalId    String? // ProfessionalProfile vendedor cuando sellerKind = profesional
  parentReturnId    String? // devolución del cliente que originó esta devolución profesional → proveedor (trazabilidad)
  projectId         String? // origen: proyecto…
  purchaseId        String? // …o compra directa
  chargeId          String? // ProviderCharge del pago original
  invoiceId         String? // Invoice del pago original (materiales facturados en proyecto)
  status            String               @default("solicitada") // solicitada|aceptada|aceptada_parcial|rechazada|cancelada|recibida|reembolsada|reembolso_fallido
  paymentMethod     String? // mercadopago|efectivo (del pago original)
  mpPaymentId       String? // pago a reembolsar
  mpRefundId        String?
  refundTotal       Float                @default(0)
  providerNote      String?
  requestedAt       DateTime             @default(now())
  respondedAt       DateTime?
  receivedAt        DateTime?
  refundedAt        DateTime?
  // reembolso en efectivo: el solicitante confirma que lo recibió (o se confirma solo a las 72 h)
  refundConfirmedAt DateTime?
  refundConfirmedBy String? // solicitante | automatico
  // recordatorio al proveedor por una devolución sin responder hace más de 72 h (una sola vez)
  reminderSentAt    DateTime?
  // cómo se reembolsó: mercadopago | efectivo | fuera_de_homia (profesional → proveedor)
  refundChannel     String?
  // reembolso por fuera de HomIA: efectivo | transferencia | saldo_a_favor, y la nota del proveedor
  refundMethod      String?
  refundMethodNote  String?
  items             LeftoverItem[]
  requester         User                 @relation(fields: [requesterId], references: [id])
  provider          ProviderProfile?     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  professional      ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  parent            LeftoverReturn?      @relation("LeftoverParent", fields: [parentReturnId], references: [id], onDelete: SetNull)
  children          LeftoverReturn[]     @relation("LeftoverParent")

  @@index([providerId, status])
  @@index([professionalId, status])
  @@index([parentReturnId])
  @@index([requesterId])
  @@index([projectId])
  @@index([purchaseId])
}

model LeftoverItem {
  id             String         @id @default(cuid())
  returnId       String
  elementId      String
  materialId     String? // ProjectMaterial origen
  purchaseId     String? // Purchase origen
  purchaseItemId String? // PurchaseItem origen (compras del carrito, multi-ítem)
  qtyRequested   Float
  qtyAccepted    Float?
  qtyReceived    Float?
  unitPricePaid  Float
  refundAmount   Float? // fijado por el proveedor al aceptar
  condition      String // sin_abrir|abierto_sin_usar
  photoUrl       String
  note           String?
  status         String         @default("propuesto") // propuesto|aceptado|rechazado
  return         LeftoverReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  element        CatalogElement @relation(fields: [elementId], references: [id])

  @@index([returnId])
}

// ── Finanzas del profesional y del proveedor (D24, migración 0033) ──
// Movimientos que carga el usuario. Lo que pasa por HomIA (facturas, ventas, devoluciones,
// compras) NO se guarda acá: se lee de sus tablas al calcular (src/lib/finanzas/datos.ts).
// Un usuario con los dos roles tiene finanzas separadas por rol.
model FinanceEntry {
  id               String    @id @default(cuid())
  userId           String
  role             String // profesional | proveedor
  // otro_ingreso | costo_directo | compra_mercaderia | gasto | inversion | retiro | aporte | prestamo | pago_prestamo
  type             String
  category         String // id de src/lib/finanzas/conceptos.ts
  description      String
  amount           Float // > 0, en pesos
  interestAmount   Float? // pago_prestamo: parte de interés (el resto es capital)
  date             DateTime
  paymentMethod    String? // efectivo|transferencia|tarjeta|mercadopago|otro
  recurring        String? // null | mensual (se proyecta cada mes al calcular, sin cron)
  recurringUntil   DateTime? // fin del recurrente (inclusive)
  projectId        String? // obra propia a la que se asigna el costo (rentabilidad por obra)
  usefulLifeMonths Int? // inversion: vida útil en meses (amortización lineal)
  status           String    @default("pagado") // pagado | pendiente (a pagar / a cobrar)
  attachmentUrl    String? // foto del comprobante (bucket público homia-uploads)
  deletedAt        DateTime? // baja lógica
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, date])
}

// Configuración de Finanzas por usuario y rol.
model FinanceConfig {
  id               String    @id @default(cuid())
  userId           String
  role             String // profesional | proveedor
  openingCash      Float? // saldo inicial de caja
  openingDate      DateTime? // desde cuándo vale el saldo inicial
  estimatedCostPct Float? // proveedor: "compro al X% del precio de venta" (estimación declarada)
  onboardedAt      DateTime? // terminó (u omitió) el primer uso guiado
  // JSON { "<providerChargeId>": "<projectId>" | "personal" }: compras de HomIA asignadas a una obra o marcadas no del negocio
  tags             String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

// ─── Métricas de uso (D27, 25/09/2026) ───
// Registro propio (first-party, sin herramientas de terceros) de CÓMO se usa HomIA: vistas de
// pantalla, clics, envíos, diálogos, búsquedas, errores y eventos de servidor (login, logout,
// registro, plan, PDF). Nunca guarda lo que se tipea en formularios, contraseñas ni el contenido
// de los mensajes. Los hechos de negocio (proyectos, facturas, pagos, pedidos, reseñas…) NO se
// duplican acá: las métricas de negocio se calculan desde sus propias tablas.
// Sin FK a User (como HomyRun): la purga y la baja de cuenta los borran explícitamente.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String? // de la cookie de sesión, nunca del cuerpo
  anonId     String // id aleatorio del navegador (homia_anon_id); se vincula al usuario al ingresar
  sessionId  String // AnalyticsSession.id
  role       String? // rol activo (cliente|profesional|proveedor) según la pantalla
  type       String // page_view|click|submit|dialog|search|error|server
  name       String // etiqueta: ruta, botón, formulario, término buscado, evento de servidor
  path       String // ruta normalizada sin ids (/panel/cliente/proyectos/:id)
  entityType String? // project|order|purchase|invoice|charge|job|bid|stock|conversation|review|work|return|professional|provider
  entityId   String?
  props      Json? // detalle chico validado (sin datos personales)
  device     String? // "celu · Chrome · Android"
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([name, createdAt])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([anonId])
  @@index([createdAt])
}

// Una sesión de uso: se corta tras 30 minutos sin actividad. `activeMs` suma solo el tiempo con
// la pestaña visible y el usuario interactuando (latidos cada 30 s).
model AnalyticsSession {
  id         String   @id @default(cuid())
  userId     String?
  anonId     String
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  activeMs   Int      @default(0)
  pageViews  Int      @default(0)
  events     Int      @default(0)
  entryPath  String?
  referrer   String? // solo el dominio de origen
  utm        Json? // utm_* del primer ingreso
  device     String?

  @@index([userId, startedAt])
  @@index([anonId])
  @@index([startedAt])
}

// ─────────────────────────── INGRESOS DE HOMIA (D30, migración 0037) ───────────────────────────
// Cada cobro mensual de la suscripción de un proveedor, tal como lo informa Mercado Pago (fuente de
// verdad). Lo llenan el webhook (tópico subscription_authorized_payment y `payment` con
// external_reference plan:provider:…), la reconciliación del cron diario y el backfill único.
// Sin FK al proveedor a propósito: el registro contable sobrevive a la baja de la cuenta
// (providerName guarda el nombre del comercio al momento del cobro).
model SubscriptionCharge {
  id                    String    @id @default(cuid())
  providerId            String
  userId                String?
  providerName          String
  plan                  String // basic|pro (de external_reference)
  mpPreapprovalId       String
  mpPaymentId           String    @unique // idempotencia
  mpAuthorizedPaymentId String? // "factura" de la suscripción en MP
  mpEnvironment         String    @default("live") // live|test: con qué token de la app Suscripciones apareció
  status                String // approved|rejected|pending|in_process|refunded|cancelled|charged_back… tal cual MP
  statusDetail          String?
  amount                Float
  currency              String    @default("ARS")
  refundedAmount        Float     @default(0)
  netAmount             Float? // transaction_details.net_received_amount (null = MP no lo informó)
  mpFee                 Float? // suma de fee_details (comisión de MP; null = sin dato)
  periodStart           DateTime? // billing_date / debit_date del período cobrado
  attemptedAt           DateTime // date_created del pago (intento de cobro)
  paidAt                DateTime? // date_approved
  source                String // webhook|cron|backfill
  raw                   Json? // mínimo, sin datos de tarjeta ni del pagador
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([providerId, attemptedAt])
  @@index([status, paidAt])
  @@index([mpPreapprovalId])
}

// Movimientos del plan de un proveedor (altas pagas, cambios de plan, bajas, reactivaciones) para
// la trazabilidad de /admin/ingresos. Se registran desde el 25/09/2026 (webhook y cron); lo anterior
// se reconstruye desde Mercado Pago (source = backfill). Idempotente por dedupeKey.
model SubscriptionEvent {
  id              String   @id @default(cuid())
  providerId      String
  providerName    String
  type            String // activada|reactivada|cambio_plan|cancelada|pausada|impago|reemplazada
  fromPlan        String?
  toPlan          String?
  mpPreapprovalId String?
  motivo          String?
  source          String // webhook|cron|backfill|homia (D33: cancelada desde HomIA)|manual
  dedupeKey       String   @unique
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  @@index([providerId, occurredAt])
  @@index([type, occurredAt])
}
