# ── Base de datos (Supabase Postgres) ──
DATABASE_URL="postgresql://…:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://…:5432/postgres"

# ── Auth (JWT httpOnly). Obligatorio en producción ──
AUTH_SECRET=

# ── URL pública: notification_url/back_urls de MP, redirect de OAuth, links ──
APP_URL=https://www.somoshomia.com

# ── Mercado Pago: app "Checkout Pro" (pagos + OAuth marketplace) ──
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TEST_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=            # Tus integraciones > app > Webhooks > Clave secreta

# ── Mercado Pago: app "Suscripciones" (planes del proveedor) ──
MP_SUB_ACCESS_TOKEN=
MP_SUB_TEST_ACCESS_TOKEN=
MP_SUB_WEBHOOK_SECRET=

# ── Precios de suscripción del proveedor (ARS/mes) ──
MP_PROVIDER_BASIC_ARS=50000
MP_PROVIDER_PRO_ARS=100000

# ── Cron de Vercel (/api/cron/reservations, header Authorization: Bearer) ──
CRON_SECRET=

# ── IA (endpoint OpenAI-compatible) ──
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_VISION_MODEL=gpt-5.4-mini

# ── Supabase Storage (buckets: homia-uploads público, dni-docs privado) ──
SUPABASE_PROJECT_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE=
