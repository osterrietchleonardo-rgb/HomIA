# ── Base de datos (Supabase Postgres) ──
DATABASE_URL="postgresql://…:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://…:5432/postgres"

# ── Auth (JWT httpOnly). Obligatorio en producción ──
AUTH_SECRET=

# ── URL pública: notification_url/back_urls de MP, redirect de OAuth, links ──
APP_URL=https://www.somoshomia.com

# ── Mercado Pago: app "Checkout Pro" (pagos + OAuth marketplace) ──
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_TEST_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=            # Tus integraciones > app > Webhooks > Clave secreta

# ── Mercado Pago: app "Suscripciones" (planes del proveedor) ──
MP_SUB_ACCESS_TOKEN=
MP_SUB_TEST_ACCESS_TOKEN=
MP_SUB_WEBHOOK_SECRET=

# ── Precios de suscripción del proveedor (ARS/mes) ──
MP_PROVIDER_BASIC_ARS=50000
MP_PROVIDER_PRO_ARS=100000

# ── Cron de Vercel (/api/cron/reservations, header Authorization: Bearer) ──
CRON_SECRET=

# ── IA (endpoint OpenAI-compatible) ──
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.4-mini
AI_VISION_MODEL=gpt-5.4-mini

# ── Supabase Storage (buckets: homia-uploads público, dni-docs privado) ──
SUPABASE_PROJECT_URL=https://<proyecto>.supabase.co
SUPABASE_SERVICE_ROLE=

# ── Súper agente Homy (Responses API /v1/responses; usa AI_API_KEY y AI_BASE_URL) ──
# Default en código: gpt-5.6-luna. Esfuerzo de razonamiento: low | medium (medido: ver informe)
HOMY_MODEL=gpt-5.6-luna
HOMY_REASONING_EFFORT=low
# Tope diario de consultas con IA de TODOS los visitantes juntos (control de gasto). Default 3000
HOMY_TOPE_DIARIO_VISITANTES=3000
# Kill-switch: 1 = Homy responde sin IA (búsqueda directa honesta)
HOMY_APAGADO=0

# ── Lanzamiento: ocultar datos de demostración (D20) ──
# 1 = las cuentas demo y de prueba (email @homia.test) no aparecen en directorio, búsqueda,
# mapa, marketplace, comparables, sponsors, perfiles públicos, bolsa de trabajos ni en Homy
# (siguen pudiendo iniciar sesión). En local va 0: las pruebas E2E crean usuarios @homia.test.
# En Vercel (Production) se pone 1 el día del lanzamiento.
HIDE_DEMO_USERS=0

# ── Mails (D18): recuperar contraseña y avisos de eventos, con Resend (resend.com) ──
# Sin RESEND_API_KEY no se manda ningún mail (la app sigue funcionando y lo loguea).
# EMAIL_FROM tiene que usar un dominio verificado en Resend (registros DNS SPF/DKIM).
# Los links de los mails usan APP_URL.
RESEND_API_KEY=
EMAIL_FROM=HomIA <avisos@vakbot.vakdor.com>
# Solo pruebas locales: manda los mails a un doble de Resend (se ignora en producción).
# RESEND_API_URL=http://127.0.0.1:3199/emails
# Solo pruebas locales (D30): consultas de cobros de suscripción a un doble de la API de MP (se ignora en producción).
# MP_API_BASE_PRUEBAS=http://localhost:3172
# D26: el registro necesita RESEND_API_KEY (el email se confirma con un código de 6 números por mail;
# esa es la verificación de la cuenta). El celular no se verifica por código: solo se estandariza.

# ── Sugerencias (D25) ──
# Área de administración /admin (D29: Métricas y bandeja de Sugerencias). Ingreso PROPIO, sin
# cuenta de usuario: se entra con este email y esta contraseña. Si falta alguna, /admin responde
# "El acceso de administración no está configurado". La contraseña: larga (20+ caracteres) y
# única (no usada en ningún otro lado). Se cambia en Vercel (Settings → Environment Variables) y
# se redeploya; al cambiarla, las sesiones de admin abiertas siguen hasta 12 h (firmadas con AUTH_SECRET).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Casilla del equipo que recibe un mail por cada envío nuevo. Vacía = la de TITULAR.email
# (src/lib/legal-content.ts, business@vakdor.com).
FEEDBACK_EMAIL=

# ── Datos de la empresa para /terminos y /privacidad (públicos) ──
# Opcionales: si faltan se usan los del código (src/lib/legal-content.ts, TITULAR).
NEXT_PUBLIC_LEGAL_RAZON_SOCIAL=
NEXT_PUBLIC_LEGAL_CUIT=
NEXT_PUBLIC_LEGAL_DOMICILIO=
NEXT_PUBLIC_LEGAL_EMAIL=
